# Northstar Retail Co. Support MVP Environment Variables

# The base URL for the backend API (used by frontend Vite)
# Local dev example: http://localhost:3000
# Do not hard-code localhost in frontend code; it will read from this variable
VITE_API_BASE_URL=

# PostgreSQL Database Connection URL (Prisma)
# Example: postgresql://username:password@localhost:5420/northstar_db?schema=public
# If left blank, the API falls back gracefully to a mock local database.
DATABASE_URL=

# The port to run the local API server on (defaults to 3000)
PORT=3000
